NOTION_API_KEY=
NOTION_DATABASE_ID=
NOTIFIER=discord
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Optional AI summary (off by default)
ENABLE_AI_SUMMARY=0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_SUMMARY_WINDOW_DAYS=3
AI_SUMMARY_MAX_TASKS=12

# Notion property names
NOTION_TASK_PROP=Task
NOTION_PRIORITY_PROP=Priority
NOTION_STATUS_PROP=Status
NOTION_DUE_PROP=Due
NOTION_DONE_CHECKBOX_PROP=done
NOTION_PROJECT_PROP=Project
NOTION_ESTIMATED_MINUTES_PROP=estimated_minutes
NOTION_CREATED_TIME_PROP=Created time
NOTION_LAST_EDITED_PROP=Last edited time

# Filtering
CLOSED_STATUS_VALUES=done
DUE_WINDOW_DAYS=7
DUE_SOON_DAYS=3
PLANNING_HORIZON_DAYS=14
FUTURE_RISK_DAILY_MINUTES_THRESHOLD=60
URGENT_LOAD_DAYS=3
URGENT_LOAD_MIN_DAILY_MINUTES=120
URGENT_LOAD_BOOST=0.25
URGENT_LOAD_HEAVY_MINUTES=180
URGENT_LOAD_HEAVY_BOOST=0.45

# Scoring
W_PRIORITY=0.5
W_DUE=0.35
W_STALE=0.15
OVERDUE_BOOST=0
STALENESS_CAP_DAYS=30
TOP3_MAX_PER_PROJECT=2
DEFAULT_ESTIMATED_MINUTES=30

# Calendar capacity (optional)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
GOOGLE_SOURCE_CALENDAR_ID=
GOOGLE_PLANNER_CALENDAR_ID=
WORKDAY_START_HOUR=9
WORKDAY_END_HOUR=18
LUNCH_START_HOUR=12
LUNCH_START_MINUTE=0
LUNCH_END_HOUR=13
LUNCH_END_MINUTE=0
FOCUS_BUFFER_MINUTES=60
PLAN_MIN_BLOCK_MINUTES=30
PLAN_MAX_BLOCKS=5
PLAN_MAX_PROJECTS=3
PLAN_CANDIDATE_LIMIT=12
PLANNER_EVENT_PREFIX=Focus Block
PLANNER_EVENT_COLOR_ID=11

# Output and schedule
MAX_SLACK_LINES=15
MAX_TASKS_PER_SECTION=2
TIMEZONE=America/Los_Angeles
MORNING_HOUR_LOCAL=9
EVENING_HOUR_LOCAL=18

# Runtime
MODE=both
DRY_RUN=1
ENFORCE_LOCAL_HOUR=1
LOG_DIR=logs
